# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# URL do projeto (Settings → API → Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Chave anônima (pública) — usada no client. Settings → API → anon public
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Chave de service role (SECRETA) — usada apenas no servidor para escrever
# ignorando RLS. NUNCA exponha no client nem commite o valor real.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------------------
# Anthropic (motor de IA — Gerente de Operações Anti-Prejuízo)
# ---------------------------------------------------------------------------
# O SDK lê ANTHROPIC_API_KEY automaticamente do ambiente.
ANTHROPIC_API_KEY=sk-ant-...
